# Staging environment — real AWS integrations
# All secrets should be in AWS Secrets Manager in production

DATABASE_URL="postgresql://user:password@your-rds-endpoint:5432/deal_coordinator"
REDIS_URL="redis://your-elasticache-endpoint:6379"
API_PORT=3001
API_URL="https://api-staging.yourdomain.com"
NEXT_PUBLIC_API_URL="https://api-staging.yourdomain.com"
WEB_PORT=3000
NODE_ENV="production"
APP_ENV="staging"
AUTH_SECRET="staging-secret-from-secrets-manager"

# Storage
STORAGE_DRIVER="s3"
S3_BUCKET="deal-coordinator-staging-files"
S3_REGION="us-east-1"
# S3_ACCESS_KEY and S3_SECRET_KEY handled by IAM role in ECS

# Auth0
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your-client-id"
AUTH0_CLIENT_SECRET="from-secrets-manager"
AUTH0_AUDIENCE="https://api-staging.yourdomain.com"

# Twilio
TWILIO_ACCOUNT_SID="from-secrets-manager"
TWILIO_AUTH_TOKEN="from-secrets-manager"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"

# DocuSign
DOCUSIGN_CLIENT_ID="from-secrets-manager"
DOCUSIGN_SECRET="from-secrets-manager"
DOCUSIGN_BASE_URL="https://demo.docusign.net/restapi"
DOCUSIGN_AUTH_DOMAIN="account-d.docusign.com"

# Google Calendar OAuth
GOOGLE_CLIENT_ID="from-google-console"
GOOGLE_SECRET="from-secrets-manager"

# Microsoft OAuth
MICROSOFT_CLIENT_ID="from-azure-portal"
MICROSOFT_SECRET="from-secrets-manager"

# AI
AI_PROVIDER="openai"
OPENAI_API_KEY="from-secrets-manager"
OPENAI_MODEL="gpt-4o-mini"
