{
  "name": "deal-coordinator",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @deal-coordinator/db generate",
    "db:migrate": "pnpm --filter @deal-coordinator/db migrate:dev",
    "db:seed": "pnpm --filter @deal-coordinator/db seed",
    "db:studio": "pnpm --filter @deal-coordinator/db studio",
    "setup": "bash scripts/setup.sh",
    "templates:ingest": "pnpm --filter @deal-coordinator/api templates:ingest"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
