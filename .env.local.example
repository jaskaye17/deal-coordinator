# Local development with Docker Compose
# Copy this to packages/db/.env and .env for local dev

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deal_coordinator?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=3001
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000
NODE_ENV="development"
APP_ENV="local"
AUTH_SECRET="dev-secret-change-in-production"

# Storage: use 'local' for filesystem, 's3' for S3/MinIO
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./tmp/storage"

# S3 / MinIO (when STORAGE_DRIVER=s3)
# S3_BUCKET="deal-coordinator-files"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_ENDPOINT="http://localhost:9000"

# AI: 'fake' uses mock provider, set OPENAI_API_KEY for real LLM
AI_PROVIDER="fake"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
