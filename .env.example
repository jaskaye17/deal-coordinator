# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deal_coordinator?schema=public"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
API_URL="http://localhost:3001"

# Chat assistant: set to 1 to skip OpenAI formatting and return deterministic backend summaries only
# CHAT_ASSISTANT_DETERMINISTIC=1

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000

# Worker
WORKER_PORT=3002

# Gateway
GATEWAY_PORT=3003

# Environment: local | staging | production
NODE_ENV="development"
APP_ENV="local"

# Auth (header-based in dev; Auth0 in staging/prod)
AUTH_SECRET="dev-secret-change-in-production"
# AUTH0_DOMAIN=""
# AUTH0_CLIENT_ID=""
# AUTH0_CLIENT_SECRET=""
# AUTH0_AUDIENCE=""

# File Storage: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./tmp/storage"
# Optional: override scan path for `pnpm templates:ingest` (default: apps/api/templates/global from repo root)
# GLOBAL_TEMPLATES_DIR="./apps/api/templates/global"
# S3 (for staging/production, or MinIO for local S3 dev)
# S3_BUCKET="deal-coordinator-files"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# AI / LLM — optional server fallback when a user has not saved a key in Settings → OpenAI
AI_PROVIDER="fake"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Twilio (SMS + WhatsApp)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# BlueBubbles (iMessage)
# BLUEBUBBLES_URL=""
# BLUEBUBBLES_API_KEY=""

# DocuSign
# DOCUSIGN_CLIENT_ID=""
# DOCUSIGN_SECRET=""
# DOCUSIGN_BASE_URL="https://demo.docusign.net/restapi"
# DOCUSIGN_AUTH_DOMAIN="account-d.docusign.com"

# Google OAuth (Calendar)
# GOOGLE_CLIENT_ID=""
# GOOGLE_SECRET=""

# Microsoft OAuth (Calendar/Outlook)
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_SECRET=""
